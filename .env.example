# ---- Required ----
# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal > your app > General Information
DISCORD_CLIENT_ID=

# ---- Optional ----
# Register commands to a single server so they appear instantly.
# Leave empty to register globally (can take up to an hour to appear).
GUILD_ID=
# Timezone for entering, displaying, and repeating schedules (IANA name).
# Examples: America/New_York, Europe/London, Asia/Tokyo. Default: UTC
TZ=UTC
# Only let users schedule posts in channels they can post in themselves.
# Set to false to let moderators post to locked channels through the bot.
ENFORCE_CHANNEL_PERMISSIONS=true

# ---- Docker Compose only ----
# User/group IDs that own the data folder. Unraid: PUID=99 PGID=100
PUID=1000
PGID=1000
# Host folder for the SQLite database.
DATA_DIR=./data

# ---- Running without Docker ----
# SQLite file path (Docker Compose sets this to /data/bot.db)
# DB_PATH=./data/bot.db
